{
  "mapping": {
    "fused_pingpong": {
      "A": {"A.phase == \"Send\"": "\"Ball\"", "otherwise": "\"NoBall\""},
      "B": {"B.phase == \"Send\"": "\"Ball\"", "otherwise": "\"NoBall\""},
      "sigma": "ta"
    }
  },
  "invariant": [
    "(A.phase == \"Send\" && B.phase == \"Wait\") || (A.phase == \"Wait\" && B.phase == \"Send\")",
    "A.phase == \"Send\" || A.sigma == inf",
    "B.phase == \"Send\" || B.sigma == inf"
  ]
}
