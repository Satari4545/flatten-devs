# Copy this file to .env and put your real key there.
# .env is gitignored and should never be committed.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Optional:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_RETRIES=3
# Comma-separated fallback models, tried in order (overrides GEMINI_MODEL):
# GEMINI_MODELS=gemini-3.8-flash
# To use OpenAI instead, install its SDK: pip install -U openai
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace_with_your_openai_api_key
# Requested model ID (not verified in OpenAI's public model catalog):
# OPENAI_MODEL=gpt-6-sol
# OPENAI_RETRIES=3
# Comma-separated fallback models, tried in order (overrides OPENAI_MODEL):
# OPENAI_MODELS=gpt-6-sol,another-available-model
# LLM rounds per fuse run:
# FUSE_MAX_ITERS=3
