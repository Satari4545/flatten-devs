# Copy this file to .env and put your real key there.
# .env is gitignored and should never be committed.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Optional:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_RETRIES=3
# Comma-separated fallback models, tried in order (overrides GEMINI_MODEL):
# GEMINI_MODELS=gemini-3.8-flash
# LLM rounds per fuse run:
# FUSE_MAX_ITERS=3
